<!--
    PyPiPie Shell window (modal and modeless).  PyPiPie branding: the title
    bar is drawn here (WindowChrome) so it follows Revit's light/dark theme.
    Colours are DynamicResources published by theme.apply_resources().
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PyPiPie Shell"
        Width="1000" Height="780" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        BorderBrush="{DynamicResource pyRevitControlBorderBrush}" BorderThickness="1">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="pps.Caption" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource pyRevitWindowForegroundBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource pyRevitControlHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="pps.CaptionClose" TargetType="Button" BasedOn="{StaticResource pps.Caption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Title bar ===== -->
        <Border Grid.Row="0" Height="34" Background="{DynamicResource pyRevitChromeBackgroundBrush}"
                BorderBrush="{DynamicResource pyRevitControlBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image x:Name="TitleIcon" Width="20" Height="20" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="PyPiPie Shell" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource pyRevitWindowForegroundBrush}"/>
                </StackPanel>
                <TextBlock x:Name="TitleDetail" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="180,0,200,0" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource pyRevitSubtleForegroundBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CapHelp" Style="{StaticResource pps.Caption}" Content="&#xE897;" ToolTip="Help (F1)"/>
                    <Button x:Name="CapMin" Style="{StaticResource pps.Caption}" Content="&#xE921;" ToolTip="Minimize"/>
                    <Button x:Name="CapMax" Style="{StaticResource pps.Caption}" Content="&#xE922;" ToolTip="Maximize"/>
                    <Button x:Name="CapClose" Style="{StaticResource pps.CaptionClose}" Content="&#xE8BB;" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="HostContent" Grid.Row="1" Focusable="False"/>
    </Grid>
</Window>
